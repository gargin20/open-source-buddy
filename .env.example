# Copy this file to .env (in the project root). Never commit .env.
# These values are read by the server only and are never sent to the browser.

PORT=3001

# "mock" = local sample data, works offline. "live" = real GitHub REST API.
GITHUB_MODE=mock
# Optional. Raises the GitHub rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# AI Provider:
# "mock"   = local sample templates, works offline with no keys.
# "gemini" = Google Gemini API. Get an API key at https://aistudio.google.com/
# "groq"   = Groq Cloud API (stub).
# "ollama" = Local Ollama server (stub).
AI_PROVIDER=mock
GEMINI_API_KEY=
# Optional: model name for Gemini (defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
OLLAMA_URL=http://localhost:11434
