# Copy this file to .env (in the project root). Never commit .env.
# These values are read by the server only and are never sent to the browser.

PORT=3001

# "mock" = local sample data, works offline. "live" = real GitHub REST API.
GITHUB_MODE=mock
# Optional. Raises the GitHub rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# mock | gemini | groq | ollama   (ollama is implemented; gemini and groq are stubs)
AI_PROVIDER=mock
GEMINI_API_KEY=
GROQ_API_KEY=
# Ollama runs locally and needs no API key. Pull the model first: ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
