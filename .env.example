# Copy this file to .env (in the project root). Never commit .env.
# These values are read by the server only and are never sent to the browser.

PORT=3001

# "mock" = local sample data, works offline. "live" = real GitHub REST API.
GITHUB_MODE=mock
# Optional. Raises the GitHub rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# mock | gemini | groq | ollama   (Gemini is implemented; Groq and Ollama are stubs)
AI_PROVIDER=mock
# Required when AI_PROVIDER=gemini. Keep this key in the server-only .env file.
GEMINI_API_KEY=
# Reserved for the Groq provider stub.
GROQ_API_KEY=
OLLAMA_URL=http://localhost:11434
