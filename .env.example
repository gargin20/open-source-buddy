# Copy this file to .env (in the project root). Never commit .env.
# These values are read by the server only and are never sent to the browser.

PORT=3001

# "mock" = local sample data, works offline. "live" = real GitHub REST API.
GITHUB_MODE=mock
# Optional. Raises the GitHub rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# Optional GitHub OAuth login. Register the callback URL in your GitHub OAuth App.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3001/api/auth/github/callback
APP_URL=http://localhost:5173
# Set to true when serving over HTTPS (automatically true in production).
AUTH_COOKIE_SECURE=

# mock | gemini | groq | ollama   (only mock is implemented)
AI_PROVIDER=mock
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_URL=http://localhost:11434
