# Copy this file to .env (in the project root). Never commit .env.
# These values are read by the server only and are never sent to the browser.

PORT=3001

# "mock" = local sample data, works offline. "live" = real GitHub REST API.
GITHUB_MODE=mock
# Optional. Raises the GitHub rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# Browser-visible app URL and server-visible API URL
APP_BASE_URL=http://localhost:5173
SERVER_BASE_URL=http://localhost:3001

# Session cookie secret
SESSION_SECRET=replace-with-a-long-random-string

# AI provider: mock | ollama
AI_PROVIDER=mock
GEMINI_API_KEY=
GROQ_API_KEY=

# Ollama is only used when AI_PROVIDER=ollama.
# Ollama must be installed and running locally.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=120000
