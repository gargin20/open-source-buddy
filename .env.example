# Copy this file to .env (in the project root). Never commit .env.
# These values are read by the server only and are never sent to the browser.

PORT=3001

# "mock" = local sample data, works offline. "live" = real GitHub REST API.
GITHUB_MODE=mock
# Optional. Raises the GitHub rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# mock | gemini | groq | ollama
AI_PROVIDER=mock
GEMINI_API_KEY=
GROQ_API_KEY=

# Ollama (local, no API key needed)
# Run "ollama serve" locally before starting the server.
# OLLAMA_URL defaults to http://localhost:11434
OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL is the model tag to use (must be pulled first: "ollama pull llama3")
OLLAMA_MODEL=llama3
