# Copy this file to .env (in the project root). Never commit .env.
# These values are read by the server only and are never sent to the browser.

PORT=3001

# "mock" = local sample data, works offline. "live" = real GitHub REST API.
GITHUB_MODE=mock
# Optional. Raises the GitHub rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# mock | gemini | groq | ollama   (only mock is implemented)
AI_PROVIDER=mock
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_URL=http://localhost:11434

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:      http://localhost:5173
#   Callback URL:      http://localhost:3001/auth/github/callback
# Leave blank to disable OAuth (the app still works — everyone is anonymous).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret used to sign the session cookie. Use any long random string.
SESSION_SECRET=change-me-in-production

# Where to redirect the browser after login/logout (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173
